{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(git branch -D *)",
      "Bash(git push origin --delete *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(./labyrinth.sh*)",
      "Bash(*bash labyrinth.sh*)",
      "Bash(*bash ./labyrinth.sh*)",
      "Bash(*pwsh*labyrinth.ps1*)",
      "Bash(*powershell*labyrinth.ps1*)",
      "Bash(bats*)",
      "Bash(*Invoke-Pester*)",
      "Bash(*tests/lint/guard.sh*)",
      "PowerShell(*labyrinth.ps1*)",
      "PowerShell(*labyrinth.sh*)",
      "PowerShell(*Invoke-Pester*)",
      "PowerShell(*bats *)",
      "PowerShell(*guard.sh*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
